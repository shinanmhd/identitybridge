{
    "name": "ignitelabs/identity-bridge",
    "description": "Laravel SDK for IdentityBridge Central — JWT auth, shadow user provisioning, webhooks",
    "type": "library",
    "keywords": ["ignitelabs", "identity-bridge", "laravel", "jwt", "authentication"],
    "homepage": "https://github.com/ignitelabs/identitybridge",
    "license": "MIT",
    "authors": [
        {
            "name": "Shinan Mohamed",
            "email": "shinaan.mv@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "orchestra/testbench": "^9.0|^10.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "IgniteLabs\\IdentityBridge\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "IgniteLabs\\IdentityBridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "IgniteLabs\\IdentityBridge\\IdentityBridgeServiceProvider"
            ],
            "aliases": {
                "Identity": "IgniteLabs\\IdentityBridge\\Facades\\Identity"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
